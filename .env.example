# ==============================================================================
# QuillAI Engineering Assessment — Local Development Environment Example
# ==============================================================================
# WARNING: All tokens below are NON-SECRET, LOCAL-ONLY demonstration fixtures.
# Never use static environment token maps for production authentication; use
# short-lived cryptographically signed OIDC/JWT tokens or mTLS in production.
# ==============================================================================

# ------------------------------------------------------------------------------
# Task 1: Custom MCP Server (packages/task-1-mcp-server)
# ------------------------------------------------------------------------------
# Log level written strictly to stderr (debug | info | warn | error | silent)
MCP_SERVER_LOG_LEVEL=info

# ------------------------------------------------------------------------------
# Task 2: MCP Security Gateway (packages/task-2-mcp-security-gateway)
# ------------------------------------------------------------------------------
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=4010
DOWNSTREAM_HOST=127.0.0.1
DOWNSTREAM_PORT=4011
DOWNSTREAM_MCP_URL=http://127.0.0.1:4011/mcp
START_DOWNSTREAM_MOCK=true
GATEWAY_TIMEOUT_MS=5000
GATEWAY_MAX_BODY_BYTES=65536

# Local-only demonstration bearer tokens (DO NOT use in production)
ADMIN_TOKEN=admin-token
VIEWER_TOKEN=viewer-token

# ------------------------------------------------------------------------------
# Shared Local LLM Provider Configuration (Tasks 3 & 4)
# ------------------------------------------------------------------------------
# Provider mode: "mock" (default, deterministic, zero external dependencies) or "ollama"
LLM_PROVIDER=mock
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TIMEOUT_MS=30000
OLLAMA_API_KEY=

# ------------------------------------------------------------------------------
# Task 3: LLM Streaming PII Redaction Gateway (packages/task-3-llm-streaming-guardrail)
# ------------------------------------------------------------------------------
STREAMING_GATEWAY_HOST=127.0.0.1
STREAMING_GATEWAY_PORT=4020
STREAMING_MAX_BODY_BYTES=131072
MOCK_CHUNK_DELAY_MS=10

# ------------------------------------------------------------------------------
# Task 4: SQLite Token Rate Limiter & Model Router (packages/task-4-model-router)
# ------------------------------------------------------------------------------
ROUTER_HOST=127.0.0.1
ROUTER_PORT=4030
ROUTER_DB_PATH=packages/task-4-model-router/data/model-router.sqlite
ROUTER_WINDOW_MS=60000
ROUTER_TOKEN_QUOTA=50000
ROUTER_DEFAULT_MAX_TOKENS=256
ROUTER_PRIMARY_TIMEOUT_MS=3000
ROUTER_SECONDARY_TIMEOUT_MS=3000
ROUTER_MAX_BODY_BYTES=131072
# Local demo scenario selector for manual mock testing (success | primary_429 | primary_timeout | primary_500 | both_unavailable)
ROUTER_DEMO_SCENARIO=success
# Optional independent Primary / Secondary provider overrides (mock | ollama | openai-compatible)
# Leave unset to inherit LLM_PROVIDER above.
ROUTER_PRIMARY_PROVIDER=
ROUTER_PRIMARY_BASE_URL=
ROUTER_PRIMARY_MODEL=
ROUTER_PRIMARY_API_KEY=
ROUTER_SECONDARY_PROVIDER=
ROUTER_SECONDARY_BASE_URL=
ROUTER_SECONDARY_MODEL=
ROUTER_SECONDARY_API_KEY=

